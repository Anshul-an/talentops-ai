# Copy this file to .env  (PowerShell:  copy .env.example .env)
# Full instructions: docs/KEYS_AND_SETUP.md
# Never commit .env. Do not invent keys — leave blanks empty.

# auto | anthropic | gemini | groq | ollama | heuristic
# auto = first available among anthropic, gemini, groq, ollama, else heuristic
LLM_PROVIDER=auto

# --- Optional paid / internship-preferred ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Free / cheap workarounds (pick one if you skip Anthropic) ---
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier, Llama): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama local (no cloud key): https://ollama.com  then  ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Local knobs (not secrets) ---
FITMENT_THRESHOLD=70
DATABASE_PATH=talentops.db
UPLOAD_DIR=uploads

# --- Company-only — no free production workaround. Do not add these as an applicant. ---
# CEIPAL_TOKEN, WHATSAPP_TOKEN, GOOGLE_CALENDAR, NAUKRI, KREDILY, TALLY, CREDFLOW
